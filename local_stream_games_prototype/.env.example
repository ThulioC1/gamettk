# Configuracao do launcher. Copie para ".env" e ajuste.
# (o loader le KEY=VALOR, ignora linhas de comentario e espacos em volta do "=")

# Porta do servidor HTTP + WebSocket (o client do jogo tambem e servido aqui)
PORT=8080

# Jogo inicial: corrida | duelo | pipa | platformer   (?game=corrida no navegador)
GAME=corrida

# Senha do bot/simulador. OBRIGATORIA se o servidor estiver exposto na internet
# (VPS): sem ela, qualquer um que abrir um WebSocket injeta comentarios e
# presentes falsos. Gere uma com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# O navegador (OBS e os viewers) nao precisa do token: ele so assiste.
GAME_TOKEN=

# ---- Bot do TikTok ----

# Username do criador da live (sem @). Ex.: https://www.tiktok.com/@fulano/live -> fulano
TIKTOK_USERNAME=

# Chave gratuita do sign-server (obrigatoria para conectar na live):
# https://www.eulerstream.com
EULER_API_KEY=

# Intervalo minimo entre eventos do MESMO viewer (ms) - evita a live tremer
COMMAND_COOLDOWN_MS=350

# Teto de eventos por minuto vindos da live inteira (0 = sem teto)
COMMAND_RATE_LIMIT_PER_MIN=180

# ---- Corrida na Live ----

# Comprimento da pista em px (px percorridos pela esquerda ate a chegada)
TRACK_LENGTH=5000

# Velocidade base do carro, em px por frame (valor / 10 = px/frame)
CAR_BASE_SPEED=45

# Impulso por comentario / presente / ultrapassagem (valor / 10 = px/frame)
COMMENT_BOOST=18
NITRO_BOOST=60
TURBO_BOOST=110

# Duracao dos efeitos, em frames de 60 Hz
BOOST_FRAMES=90
SPIN_FRAMES=70
RESTART_DELAY_FRAMES=420

# Pontos por comentario e por presente (usado no placar do HUD)
POINT_PER_COMMENT=1

# Largada: contagem regressiva antes de "VALENDO!", grid e faixas da pista
COUNTDOWN_SECONDS=10     # "LARGADA EM 00:10"
GRID_COLUMNS=8           # carros por fila no grid
GRID_COLUMN_GAP=105      # distancia entre carros da mesma fila (px de pista)
GRID_ROW_GAP=190         # distancia entre faixas (px de pista)
CAR_LANES=5              # faixas visiveis na tela

# Conversao px/frame -> km/h mostrados na placa do carro
KMH_FACTOR=40
KMH_MAX=400           # teto do mostrador (nada de 1300 km/h na tela)

# --- like: quanto mais a pessoa curte, mais o carro acelera ---
LIKE_BOOST_STEP=6          # px/frame de impulso por curtida (/100)
LIKE_BOOST_FRAMES=90       # duracao base do impulso (frames)
LIKE_SPEED_CAP=150         # teto do impulso dos likes (/10)
LIKE_FRAMES_PER_LIKE=4     # frames extras por curtida acumulada
LIKE_BOOST_DECAY=99950      # decai devagar (/100000): o like vale a corrida toda

# --- os dois carros que ficam sempre na pista, mesmo com a live vazia ---
RIVAL_1_NAME=Vitinmilgrau
RIVAL_1_VEHICLE=g8
RIVAL_2_NAME=Narutobebado
RIVAL_2_VEHICLE=xre300
RIVAL_SPEED=88             # fator de velocidade deles (/100) - 88 = um pouco abaixo da media

# Catalogo de veiculos (Gol, Uno, Fusca, motos...). Vazio = config/carros.json
CARROS_CONFIG=

# Personalizacao do duelo e da arena (vazio = config/duel.json, config/pipa.json)
DUEL_CONFIG=
PIPA_CONFIG=

# Numero maximo de carros simultaneos na pista
CAR_MAX=40

# ---- Presentes -> efeitos ----
# O efeito vem do NOME do presente; a POTENCIA vem do VALOR em moedas
# (gift.diamond_count), em faixas: 1-19 x1, 20-199 x2, 200-999 x3,
# 1000-4999 x4, 5000-14999 x6, 15000+ x8. Presente desconhecido = nitro x1.

GIFT_NITRO_KEYWORDS=rosa,gg,casquinha,sorvete,panda,perfume,eu te amo,te amo,confete,oculos de sol,oculos
GIFT_OIL_KEYWORDS=chuva de dinheiro,chuva,dinheiro
GIFT_TURBO_KEYWORDS=galaxia,bola de espelhos,espelhos,sereia,aviao,planeta,voo diamante,diamante,leao,mini leao,universo tiktok,universo,tiktok universe
